{
  "name": "magpie-panel",
  "version": "0.2.0",
  "description": "Magpie plugin for Magpie Panel: finds, downloads and launches the floating panel app",
  "type": "module",
  "main": "./plugin/index.js",
  "exports": {
    ".": "./plugin/index.js",
    "./server": "./plugin/index.js"
  },
  "files": [
    "plugin/index.js",
    "plugin/version.js",
    "plugin/platform.js",
    "plugin/page",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owogametools/magpie-statusP.git"
  },
  "homepage": "https://github.com/owogametools/magpie-statusP#readme",
  "keywords": [
    "magpie",
    "magpie-plugin",
    "panel"
  ],
  "magpie": {
    "name": "Magpie Panel",
    "summary": {
      "en": "A floating panel for Magpie: usage, agents, quick actions, and a live avatar.",
      "zh": "常駐懸浮面板：用量、Agents、快速操作，以及隨路由變化的形象。"
    },
    "icon": "data:image/svg+xml;base64,",
    "page": {
      "title": "Magpie Panel",
      "file": "plugin/page/index.html",
      "icon": "plugin/page/icon.svg",
      "titles": {
        "zh": "懸浮面板",
        "zh-TW": "懸浮面板",
        "en": "Magpie Panel"
      }
    },
    "permissions": [
      "usage:summary"
    ],
    "options": {
      "binaryPath": "",
      "autoLaunch": true
    }
  }
}
